# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FitForge' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26's Clang claims consteval support but fails on fmt's
    # FMT_STRING(...) call sites in format-inl.h ("call to consteval
    # function ... is not a constant expression"). fmt/include/fmt/base.h
    # unconditionally re-#defines FMT_USE_CONSTEVAL itself (no #ifndef
    # guard), so overriding it via -D on the command line gets silently
    # clobbered. Instead, compile just the fmt pod as C++17 — fmt's own
    # feature-detection ladder treats anything below C++20 as "no
    # consteval support" and falls back to runtime format-string
    # validation, which is the documented/supported path, not a hack.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |bc|
          bc.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
